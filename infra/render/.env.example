# Minimum environment for Lumio on Render.
# Copy these into the web service. Do not commit real values.
#
# Render sets PORT and RENDER_EXTERNAL_URL. start.sh derives BETTER_AUTH_URL,
# WEB_ORIGIN, API_URL, and host allowlists from the public URL.

# Required. Internal Postgres URL from the Render database linked to this service.
DATABASE_URL=

# Required. Independent long random secrets. ENCRYPTION_KEY must be 64 hex characters.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=

# Required for this image. start.sh also defaults these if unset.
NODE_ENV=production
DATA_DIR=/tmp/lumio-data
SIGNUPS_ENABLED=true
PHONE_CALLS_ENABLED=true
SANDBOX_PROVIDER=e2b

# Optional. Computers need E2B_API_KEY. Connect apps need COMPOSIO_API_KEY.
E2B_API_KEY=
COMPOSIO_API_KEY=
