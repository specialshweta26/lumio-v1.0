[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/lumio/backup.env
ExecStart=/usr/local/sbin/lumio-host-check
StateDirectory=lumio/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/lumio/alerts
ProtectHome=true
PrivateTmp=true
