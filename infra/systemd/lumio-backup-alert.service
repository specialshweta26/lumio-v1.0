[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lumio-host-alert backup-failure "Nightly backup failed. Inspect lumio-backup.service on the server."
StateDirectory=lumio/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/lumio/alerts
PrivateTmp=true
