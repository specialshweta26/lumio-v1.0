---
type Props = {
  otherName: string;
  lumio: readonly string[];
  other: readonly string[];
};

const { otherName, lumio, other } = Astro.props;
---

<figure class="vs-card">
  <div class="vs-card__grid">
    <div class="vs-card__col">
      <p class="vs-card__name">Lumio</p>
      <ul>
        {lumio.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <p class="vs-card__vs" aria-hidden="true">vs</p>
    <div class="vs-card__col">
      <p class="vs-card__name">{otherName}</p>
      <ul>
        {other.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <figcaption class="sr-only">Lumio compared with {otherName}</figcaption>
</figure>
